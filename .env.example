# Database - PostgreSQL (matches production)
# For local development with Docker:
DATABASE_URL="postgresql://shuttle_user:dev_password_local@localhost:5433/shuttle_booking_dev"

# Alternative: Use production database for testing (be careful!)
# DATABASE_URL="postgresql://shuttle_user:secure_lFiFL*x8ftaeWDgu7R65e@db:5432/shuttle_booking"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="your-secret-here"

# Production URLs (update for live site)
# NEXTAUTH_URL="https://tjoeftjaf.xyz"

# Email Configuration
# For Gmail, you'll need to:
# 1. Enable 2-factor authentication on your Google account
# 2. Generate an App Password (not your regular password)
# 3. Use your Gmail address as EMAIL_USER
# 4. Use the App Password as EMAIL_PASS
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"

# Cron Secret for reminder API endpoint
# Generate a random string for production
CRON_SECRET="your-cron-secret-key"

# iCloud Calendar (optional)
ICAL_URL="your-ical-url"
ICAL_USERNAME="your-username"
ICAL_PASSWORD="your-password"